# ===================================================
# Application Port & Environment
# ===================================================
PORT=3000
NODE_ENV=development

# ===================================================
# Database Configuration (MongoDB)
# ===================================================
# For Local Development:
# MONGODB_URI=mongodb://localhost:27017/ojt-etr
#
# For Production (MongoDB Atlas):
# Replace <username>, <password>, and cluster domain with your Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ojt-etr?retryWrites=true&w=majority

# ===================================================
# Authentication & Security
# ===================================================
JWT_SECRET=your_super_secret_jwt_key_here

# ===================================================
# Google Gemini Chatbot API
# ===================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ===================================================
# Cloudinary Cloud Storage (Images & Documents)
# ===================================================
# Sign up at https://cloudinary.com (Free tier: 25GB)
# If left blank, the app will automatically fall back to local /uploads storage.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Alternatively, you can provide the single CLOUDINARY_URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

